# Bot token from https://discord.com/developers/applications (Bot tab).
# Leave empty to run only the dashboard.
DISCORD_TOKEN=

# SQLite database location. The docker image overrides this to /data/scorpio.db.
DATABASE_URL=sqlite://data/scorpio.db?mode=rwc

# Address the dashboard listens on.
WEB_BIND=0.0.0.0:8080

# Set to true when the dashboard is served over HTTPS (recommended).
COOKIE_SECURE=false

# Set to true only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Password for the `root` account, used only when the account is first created.
# If empty, a random password is generated and printed to the log once.
ROOT_PASSWORD=

RUST_LOG=info

# docker compose only: user and group the container runs as, so files in ./data
# belong to you. Defaults to 1000, check yours with `id -u` and `id -g`.
#PUID=1000
#PGID=1000
